+/* Header on top, the browser fills the rest of the window */
+.page {
+  height: 100%;
+  display: grid;
+  grid-template-rows: auto 1fr;
+  background-color: var(--color-bg-page);
+}
+
+.page > header {
+  margin-bottom: 0;
+}
+
+.body {
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 16px 24px 24px;
+}
+
+/* ===== Toolbar ===== */
+.toolbar {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 8px;
+  background-color: var(--color-bg-card);
+  border: 1px solid var(--color-border-card);
+  border-radius: 12px;
+}
+
+.iconButton {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 34px;
+  height: 34px;
+  flex-shrink: 0;
+  border-radius: 8px;
+  color: var(--color-text-secondary);
+  transition:
+    background-color 150ms ease,
+    color 150ms ease;
+}
+
+.iconButton svg {
+  width: 18px;
+  height: 18px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.6;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.iconButton:hover:not(:disabled) {
+  background-color: var(--color-bg-panel);
+  color: var(--color-text-primary);
+}
+
+.iconButton:disabled {
+  cursor: not-allowed;
+  opacity: 0.4;
+}
+
+.addressForm {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex: 1;
+  min-width: 0;
+  height: 34px;
+  padding: 0 12px;
+  background-color: var(--color-bg-panel);
+  border: 1px solid transparent;
+  border-radius: 8px;
+  transition: border-color 150ms ease;
+}
+
+.addressForm:focus-within {
+  border-color: var(--color-accent-purple);
+}
+
+.addressIcon {
+  display: inline-flex;
+  flex-shrink: 0;
+  color: var(--color-text-subtle);
+}
+
+.addressIcon svg {
+  width: 15px;
+  height: 15px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.6;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.addressInput {
+  flex: 1;
+  min-width: 0;
+  height: 100%;
+  background: transparent;
+  border: none;
+  outline: none;
+  font-size: 0.875rem;
+  color: var(--color-text-primary);
+}
+
+.addressInput::placeholder {
+  color: var(--color-text-subtle);
+}
+
+.spinner {
+  width: 15px;
+  height: 15px;
+  flex-shrink: 0;
+  border: 2px solid var(--color-accent-spinner-track);
+  border-top-color: var(--color-accent-spinner);
+  border-radius: 50%;
+  animation: resources-spin 700ms linear infinite;
+}
+
+@keyframes resources-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+/* ===== Browser surface ===== */
+.viewport {
+  position: relative;
+  flex: 1;
+  min-height: 0;
+  overflow: hidden;
+  background-color: var(--color-bg-card);
+  border: 1px solid var(--color-border-card);
+  border-radius: 12px;
+}
+
+.start {
+  height: 100%;
+  overflow: auto;
+  padding: 32px;
+}
+
+.startHeader {
+  margin-bottom: 24px;
+}
+
+.title {
+  font-size: 2rem;
+  font-weight: 800;
+  line-height: 1.2;
+  letter-spacing: -0.02em;
+  color: var(--color-text-primary);
+}
+
+.subtitle {
+  margin-top: 4px;
+  max-width: 640px;
+  font-size: 0.875rem;
+  line-height: 1.5;
+  color: var(--color-text-secondary);
+}
+
+.sites {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
+  gap: 8px;
+}
+
+.site {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  width: 100%;
+  padding: 12px 14px;
+  text-align: left;
+  background-color: var(--color-bg-panel);
+  border: 1px solid transparent;
+  border-radius: 10px;
+  transition:
+    background-color 150ms ease,
+    border-color 150ms ease;
+}
+
+.site:hover {
+  background-color: var(--color-accent-tint);
+  border-color: var(--color-accent-purple-wash);
+}
+
+.siteName {
+  overflow: hidden;
+  font-size: 0.875rem;
+  font-weight: 600;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  color: var(--color-text-primary);
+}
+
+.siteHint {
+  flex-shrink: 0;
+  font-size: 0.75rem;
+  font-weight: 600;
+  color: var(--color-accent-text);
+  opacity: 0;
+  transition: opacity 150ms ease;
+}
+
+.site:hover .siteHint,
+.site:focus-visible .siteHint {
+  opacity: 1;
+}
+
+.muted {
+  font-size: 0.875rem;
+  color: var(--color-text-secondary);
+}
+
+.footnote {
+  margin-top: 24px;
+  font-size: 0.75rem;
+  color: var(--color-text-subtle);
+}
+
+/* ===== Blocked / error / desktop-only panels ===== */
+.notice {
+  height: 100%;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  padding: 32px;
+  text-align: center;
+}
+
+.noticeBadge {
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  margin-bottom: 4px;
+  border-radius: 12px;
+  background-color: var(--color-accent-tint);
+  color: var(--color-accent-text);
+}
+
+.noticeBadge svg {
+  width: 22px;
+  height: 22px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.6;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.noticeBadgeError {
+  background-color: var(--color-status-error-tint);
+  color: var(--color-status-error-icon);
+}
+
+.noticeTitle {
+  font-size: 1.25rem;
+  font-weight: 700;
+  color: var(--color-text-primary);
+}
+
+.noticeText {
+  max-width: 460px;
+  font-size: 0.9375rem;
+  line-height: 1.5;
+  color: var(--color-text-secondary);
+}
+
+.noticeHint {
+  max-width: 460px;
+  font-size: 0.8125rem;
+  line-height: 1.5;
+  color: var(--color-text-subtle);
+}
+
+.noticeActions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 8px;
+  margin-top: 12px;
+}
+
+.primaryButton,
+.secondaryButton {
+  height: 36px;
+  padding: 0 16px;
+  border-radius: 8px;
+  font-size: 0.875rem;
+  font-weight: 600;
+  transition:
+    background-color 150ms ease,
+    color 150ms ease;
+}
+
+.primaryButton {
+  background-color: var(--color-button-primary-bg);
+  color: var(--color-button-primary-text);
+}
+
+.primaryButton:hover {
+  background-color: var(--color-button-primary-bg-hover);
+}
+
+.secondaryButton {
+  background-color: var(--color-bg-button-secondary);
+  color: var(--color-text-secondary);
+}
+
+.secondaryButton:hover:not(:disabled) {
+  color: var(--color-text-primary);
+}
+
+.secondaryButton:disabled {
+  cursor: not-allowed;
+  opacity: 0.5;
+}
+
+@media (max-width: 767px) {
+  .body {
+    padding: 12px;
+  }
+
+  .start {
+    padding: 20px;
+  }
+
+  .sites {
+    grid-template-columns: 1fr;
+  }
+}

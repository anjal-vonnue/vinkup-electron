{
  "name": "desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Electron desktop shell for Vinkup",
  "author": "Vinkup",
  "homepage": "https://vinkup.netlify.app",
  "desktopName": "vinkup.desktop",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest",
    "dev": "npm run build && NODE_ENV=development node scripts/run-electron.mjs .",
    "start": "npm run build && NODE_ENV=production node scripts/run-electron.mjs .",
    "rebuild": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "chrome-launcher": "^1.2.3",
    "esbuild": "^0.28.2",
    "http-proxy": "^1.18.1",
    "lighthouse": "^13.6.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@itp/types": "^1.0.0",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24.19.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "~6.0.2"
  }
}

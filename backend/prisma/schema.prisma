generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Staff accounts (mentors and managers) ----------
// Existing rows mapped to MENTOR during role migration. Keep table name `admin`
// for compatibility with existing review foreign keys.
model admin {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique // stored lower-case
  name          String
  role          staff_role @default(MENTOR)
  is_active     Boolean    @default(true) // false = can no longer log in
  created_at    DateTime   @default(now()) @db.Timestamptz
  last_login_at DateTime?  @db.Timestamptz

  reviews           task_review[]
  leave_reviews     leave_request[] @relation("LeaveReviewer")
  assigned_trainees trainee[]       @relation("MentorTrainees")

  created_checkpoints  checkpoint[]         @relation("CheckpointCreator")
  graded_attempts      checkpoint_attempt[] @relation("CheckpointGrader")
  checkpoint_groups    trainee_group[]      @relation("CheckpointGroupCreator")
}

// ---------- Enums ----------

enum task_runtime {
  browser
  node
  sql
}

enum task_status {
  not_started
  in_progress
  completed
}

enum flag_event_type {
  FULLSCREEN_EXIT
  TAB_SWITCH
  PASTE_BLOCKED
  WINDOW_BLUR
}

enum review_priority {
  LOW
  NORMAL
  HIGH
}

// Admin review of a submitted task: pending = waiting for an admin decision.
enum review_status {
  pending
  approved
  rework
}

// The decision recorded in one review history entry.
enum review_decision {
  approved
  rework
}

enum staff_role {
  MENTOR
  MANAGER
}

// A leave request has exactly one final decision. Historical rows are never
// deleted when the decision is recorded.
enum leave_status {
  PENDING
  APPROVED
  REJECTED
}

model trainee {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  email     String  @unique
  is_active Boolean @default(true) // false = can no longer log in
  mentor_id String? @db.Uuid

  mentor            admin?               @relation("MentorTrainees", fields: [mentor_id], references: [id], onDelete: SetNull)
  task_progress     task_progress[]
  task_reviews      task_review[]
  leave_requests    leave_request[]
  day_completions   day_completion[]
  journal_responses journal_response[]
  typing_results    typing_test_result[]
  flag_events       flag_event[]
  activity_logs     activity_log[]

  checkpoint_group_memberships trainee_group_member[]
  checkpoint_assignments       checkpoint_assignment[]
  checkpoint_attempts          checkpoint_attempt[]

  @@index([mentor_id])
}

// ---------- Curriculum (same for every trainee; loaded by the seed script) ----------

model course {
  id         String @id // "html", "css", "js", "ts", "node", "postgresql", "prisma", "react"
  title      String
  sort_order Int    @unique // curriculum order: html = 1 ... react = 8

  days curriculum_day[]
}

model curriculum_day {
  id             String @id // "css-day-03"
  course_id      String
  day_number     Int
  title          String
  subtitle       String // also the dashboard's short description
  lesson_summary String
  journal_prompt String

  course              course               @relation(fields: [course_id], references: [id])
  learning_objectives learning_objective[]
  self_check_items    self_check_item[]
  tasks               task[]
  completions         day_completion[]
  journal_responses   journal_response[]

  @@unique([course_id, day_number])
}

model learning_objective {
  id                String @id // "html-1-obj-1"
  curriculum_day_id String
  code              String // "1.1"
  title             String
  description       String
  sort_order        Int

  curriculum_day curriculum_day @relation(fields: [curriculum_day_id], references: [id], onDelete: Cascade)

  @@index([curriculum_day_id, sort_order])
}

model self_check_item {
  id                String  @id // "html-1-check-1"
  curriculum_day_id String
  code              String
  label             String
  description       String
  is_required       Boolean @default(true)
  sort_order        Int

  curriculum_day curriculum_day @relation(fields: [curriculum_day_id], references: [id], onDelete: Cascade)

  @@index([curriculum_day_id, sort_order])
}

model task {
  id                    String       @id // "css-day-03-t-2"
  curriculum_day_id     String
  sequence_order        Int
  title                 String
  instructions_markdown String
  is_stretch_goal       Boolean      @default(false)
  estimated_minutes     Int?
  runtime               task_runtime
  run_command           String? // node only, e.g. "npm test"
  setup_sql             String? // sql only
  starter_files         Json         @default("[]") // TaskFile[]: [{ "path": "index.html", "content": "..." }]

  curriculum_day curriculum_day  @relation(fields: [curriculum_day_id], references: [id], onDelete: Cascade)
  progress       task_progress[]
  flag_events    flag_event[]
  reviews        task_review[]

  @@unique([curriculum_day_id, sequence_order])
}

// ---------- Trainee data ----------

model task_progress {
  id               String         @id @default(uuid()) @db.Uuid
  trainee_id       String         @db.Uuid
  task_id          String
  status           task_status    @default(in_progress)
  review_status    review_status?
  submission_count Int            @default(0)

  files           Json? // Trainee's current working files
  submitted_files Json? // Snapshot of the latest submission

  code_updated_at    DateTime? @db.Timestamptz
  first_submitted_at DateTime? @db.Timestamptz
  last_submitted_at  DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz

  trainee trainee @relation(fields: [trainee_id], references: [id], onDelete: Cascade)
  task    task    @relation(fields: [task_id], references: [id])

  @@unique([trainee_id, task_id])
}

// One admin review of one submission attempt. History is append-only: rows are
// never updated or deleted by the API, so every past review stays readable.
model task_review {
  id            String          @id @default(uuid()) @db.Uuid
  trainee_id    String          @db.Uuid
  task_id       String
  admin_id      String          @db.Uuid
  // The task_progress.submission_count value of the submission this review judged.
  submission_no Int
  decision      review_decision
  // Admin feedback. Empty for an approval written without a note.
  feedback      String          @default("")
  reviewed_at   DateTime        @default(now()) @db.Timestamptz
  created_at    DateTime        @default(now()) @db.Timestamptz
  updated_at    DateTime        @updatedAt @db.Timestamptz

  trainee trainee @relation(fields: [trainee_id], references: [id], onDelete: Cascade)
  task    task    @relation(fields: [task_id], references: [id], onDelete: Cascade)
  admin   admin   @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  // One review per submission attempt: two admins cannot both judge the same attempt.
  @@unique([trainee_id, task_id, submission_no])
  @@index([trainee_id, task_id, reviewed_at])
  @@index([trainee_id, reviewed_at])
}

// Trainee leave application. One row is kept for the whole lifecycle; review
// writes flip PENDING to a final status once. Restrict on both people keeps
// historical requests and reviewer details intact if accounts are deleted.
model leave_request {
  id            String        @id @default(uuid()) @db.Uuid
  trainee_id    String        @db.Uuid
  subject       String        @db.VarChar(200)
  reason        String        @db.Text
  status        leave_status  @default(PENDING)
  reviewer_id   String?       @db.Uuid
  reviewer_role staff_role?
  reviewer_name String?
  feedback      String?       @db.Text
  submitted_at  DateTime      @default(now()) @db.Timestamptz
  reviewed_at   DateTime?     @db.Timestamptz
  created_at    DateTime      @default(now()) @db.Timestamptz
  updated_at    DateTime      @updatedAt @db.Timestamptz

  trainee  trainee @relation(fields: [trainee_id], references: [id], onDelete: Restrict)
  reviewer admin?  @relation("LeaveReviewer", fields: [reviewer_id], references: [id], onDelete: Restrict)

  @@index([trainee_id, submitted_at])
  @@index([status, submitted_at])
}

model day_completion {
  id                String   @id @default(uuid()) @db.Uuid
  trainee_id        String   @db.Uuid
  curriculum_day_id String
  completed_at      DateTime @default(now()) @db.Timestamptz

  trainee        trainee        @relation(fields: [trainee_id], references: [id], onDelete: Cascade)
  curriculum_day curriculum_day @relation(fields: [curriculum_day_id], references: [id])

  @@unique([trainee_id, curriculum_day_id])
}

model journal_response {
  id                String   @id @default(uuid()) @db.Uuid
  trainee_id        String   @db.Uuid
  curriculum_day_id String
  response_text     String
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  trainee        trainee        @relation(fields: [trainee_id], references: [id], onDelete: Cascade)
  curriculum_day curriculum_day @relation(fields: [curriculum_day_id], references: [id])

  @@unique([trainee_id, curriculum_day_id])
}

model typing_test_result {
  id         String   @id @default(uuid()) @db.Uuid
  trainee_id String   @db.Uuid
  wpm        Int
  accuracy   Float // 0-100, rounded to one decimal by the service
  taken_at   DateTime @default(now()) @db.Timestamptz

  trainee trainee @relation(fields: [trainee_id], references: [id], onDelete: Cascade)

  @@index([trainee_id, taken_at])
}

model flag_event {
  id              String          @id @default(uuid()) @db.Uuid
  trainee_id      String          @db.Uuid
  task_id         String
  type            flag_event_type
  review_priority review_priority @default(NORMAL)
  context_data    Json?
  duration_ms     Int?
  timestamp       DateTime        @default(now()) @db.Timestamptz

  trainee trainee @relation(fields: [trainee_id], references: [id], onDelete: Cascade)
  task    task    @relation(fields: [task_id], references: [id])

  @@index([trainee_id, task_id, timestamp])
}

model activity_log {
  id             String   @id @default(uuid()) @db.Uuid
  trainee_id     String   @db.Uuid
  date           DateTime @db.Date // calendar day in Asia/Kolkata
  active_seconds Int      @default(0)
  coding_seconds Int      @default(0)

  trainee trainee @relation(fields: [trainee_id], references: [id], onDelete: Cascade)

  @@unique([trainee_id, date])
}

// ---------- Electron sign-in ----------
// A short-lived transaction binds one browser OAuth attempt to the Electron
// process that started it. No Vinkup token is ever placed in a redirect URL;
// only a one-time handoff code is.

// ---------- Checkpoint assessments ----------
// A manager authors a checkpoint from an uploaded Markdown paper. The parsed
// questions and instructions are stored so a paper cannot change after trainees
// have started an attempt.

enum checkpoint_status {
  DRAFT
  SCHEDULED
  CANCELLED
}

enum checkpoint_question_type {
  TEXT
  LONG_TEXT
  CODE
  SQL
  MULTIPLE_CHOICE
  FILE
  PRACTICAL
}

enum checkpoint_result_visibility {
  IMMEDIATE
  AFTER_APPROVAL
}

enum checkpoint_attempt_status {
  IN_PROGRESS
  SUBMITTED
}

enum checkpoint_submission_reason {
  MANUAL
  TIME_EXPIRED
  CANCELLED
}

model checkpoint {
  id                  String    @id @default(uuid()) @db.Uuid
  title               String
  description         String    @default("")
  source_file_name    String?
  source_markdown     String    @db.Text
  instructions_markdown String  @db.Text
  duration_minutes    Int
  total_marks         Int
  passing_marks       Int
  start_at            DateTime? @db.Timestamptz
  status              checkpoint_status @default(DRAFT)
  max_attempts        Int       @default(1)
  allow_early_submission Boolean @default(true)
  allow_late_entry    Boolean   @default(true)
  result_visibility   checkpoint_result_visibility @default(AFTER_APPROVAL)
  results_published_at DateTime? @db.Timestamptz
  created_by_id       String    @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @updatedAt @db.Timestamptz

  created_by admin                 @relation("CheckpointCreator", fields: [created_by_id], references: [id], onDelete: Restrict)
  questions  checkpoint_question[]
  assignments checkpoint_assignment[]
  attempts   checkpoint_attempt[]

  @@index([status, start_at])
}

model checkpoint_question {
  id              String   @id @default(uuid()) @db.Uuid
  checkpoint_id   String   @db.Uuid
  order_index     Int
  title           String
  prompt_markdown String   @db.Text
  type            checkpoint_question_type
  marks           Int
  options         Json?
  correct_option  String?
  code_language   String?
  // Practical questions: how the trainee's workspace runs and what it starts with.
  runtime         String?
  run_command     String?
  setup_sql       String?  @db.Text
  starter_files   Json?

  checkpoint checkpoint        @relation(fields: [checkpoint_id], references: [id], onDelete: Cascade)
  answers    checkpoint_answer[]

  @@unique([checkpoint_id, order_index])
  @@index([checkpoint_id])
}

// Groups are manager-owned reusable sets of trainees. Assigning a checkpoint to
// a group does not copy members: membership is resolved at read/start time.
model trainee_group {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  created_by_id String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz

  creator     admin                  @relation("CheckpointGroupCreator", fields: [created_by_id], references: [id], onDelete: Restrict)
  members     trainee_group_member[]
  assignments checkpoint_assignment[]

  @@unique([created_by_id, name])
}

model trainee_group_member {
  group_id   String @db.Uuid
  trainee_id String @db.Uuid

  group   trainee_group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  trainee trainee       @relation(fields: [trainee_id], references: [id], onDelete: Cascade)

  @@id([group_id, trainee_id])
  @@index([trainee_id])
}

// Exactly one of trainee_id / group_id is set (enforced by a CHECK constraint in
// the migration). A checkpoint can be assigned to a trainee directly and through
// one of their groups; the service de-duplicates when resolving access.
model checkpoint_assignment {
  id            String @id @default(uuid()) @db.Uuid
  checkpoint_id String @db.Uuid
  trainee_id    String? @db.Uuid
  group_id      String? @db.Uuid

  checkpoint checkpoint    @relation(fields: [checkpoint_id], references: [id], onDelete: Cascade)
  trainee    trainee?      @relation(fields: [trainee_id], references: [id], onDelete: Cascade)
  group      trainee_group? @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([checkpoint_id])
  @@index([trainee_id])
  @@index([group_id])
}

model checkpoint_attempt {
  id                String   @id @default(uuid()) @db.Uuid
  checkpoint_id     String   @db.Uuid
  trainee_id        String   @db.Uuid
  attempt_number    Int      @default(1)
  status            checkpoint_attempt_status @default(IN_PROGRESS)
  session_token     String   @unique
  started_at        DateTime @db.Timestamptz
  deadline_at       DateTime @db.Timestamptz
  submitted_at      DateTime? @db.Timestamptz
  submission_reason checkpoint_submission_reason?
  last_seen_at      DateTime @default(now()) @db.Timestamptz
  total_score       Float?
  feedback          String?  @db.Text
  graded_by_id      String?  @db.Uuid
  graded_at         DateTime? @db.Timestamptz
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  checkpoint checkpoint @relation(fields: [checkpoint_id], references: [id], onDelete: Cascade)
  trainee    trainee    @relation(fields: [trainee_id], references: [id], onDelete: Cascade)
  graded_by  admin?     @relation("CheckpointGrader", fields: [graded_by_id], references: [id], onDelete: SetNull)
  answers    checkpoint_answer[]
  events     checkpoint_attempt_event[]

  @@unique([checkpoint_id, trainee_id, attempt_number])
  @@index([status, deadline_at])
  @@index([trainee_id, status])
}

model checkpoint_answer {
  id             String   @id @default(uuid()) @db.Uuid
  attempt_id     String   @db.Uuid
  question_id    String   @db.Uuid
  answer_text    String?  @db.Text
  selected_option String?
  file_name      String?
  file_mime_type String?
  file_size      Int?
  file_data      String?  @db.Text // base64 payload
  workspace_files Json?   // practical questions: submitted workspace files
  client_revision Int     @default(0)
  awarded_marks  Float?
  feedback       String?  @db.Text
  saved_at       DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @updatedAt @db.Timestamptz

  attempt  checkpoint_attempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question checkpoint_question @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([attempt_id, question_id])
  @@index([attempt_id])
}

// Append-only audit trail shown on the manager's submission review.
model checkpoint_attempt_event {
  id         String   @id @default(uuid()) @db.Uuid
  attempt_id String   @db.Uuid
  type       String
  message    String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz

  attempt checkpoint_attempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@index([attempt_id, created_at])
}

model desktop_auth_transaction {
  id                    String    @id @default(uuid()) @db.Uuid
  state                 String    @unique
  code_challenge        String
  code_challenge_method String
  loopback_redirect_uri String
  status                String    @default("pending") // pending | processing | authenticated | failed | consumed
  user_id               String?   @db.Uuid
  user_email            String?
  user_name             String?
  user_role             String?
  error_code            String?
  handoff_code_hash     String?   @unique
  handoff_expires_at    DateTime? @db.Timestamptz
  handoff_consumed_at   DateTime? @db.Timestamptz
  expires_at            DateTime  @db.Timestamptz
  consumed_at           DateTime? @db.Timestamptz
  created_at            DateTime  @default(now()) @db.Timestamptz

  @@index([expires_at])
}

// A long-lived refresh session. Only a SHA-256 hash of the refresh token is
// stored, so a database read cannot be replayed as a session.
model desktop_session {
  id                 String    @id @db.Uuid
  user_id            String    @db.Uuid
  user_email         String
  user_name          String
  user_role          String
  refresh_token_hash String    @unique
  expires_at         DateTime  @db.Timestamptz
  last_used_at       DateTime  @default(now()) @db.Timestamptz
  revoked_at         DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz

  @@index([user_id])
  @@index([expires_at])
}
